{
  "author": "Jens Oliver Meiert",
  "bin": {
    "sparklemacsparkline": "bin/sparklemacsparkline.js"
  },
  "description": "Non-British SVG sparkline generator for build steps and the command line, as seen on dxsrc.org and meiert.com",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "bin",
    "src"
  ],
  "funding": "https://github.com/j9t/sparklemacsparkline?sponsor=1",
  "homepage": "https://github.com/j9t/sparklemacsparkline",
  "keywords": [
    "accessibility",
    "charts",
    "data-visualization",
    "sparklemacsparkline",
    "sparklines",
    "static-site-generators",
    "svg",
    "visualization"
  ],
  "license": "MIT",
  "name": "sparklemacsparkline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j9t/sparklemacsparkline.git"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node ./bin/sparklemacsparkline.js",
    "test": "npm run test:types && node --test \"test/**/*.test.js\"",
    "test:types": "tsc"
  },
  "type": "module",
  "types": "src/index.d.ts",
  "version": "1.0.2"
}